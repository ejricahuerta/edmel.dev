# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives contact form submissions
CONTACT_EMAIL=you@example.com

# Must be a verified sender/domain in Resend (e.g. "Edmel <hello@yourdomain.com>").
# Use your own domain in Resend (SPF/DKIM). The shared onboarding@resend.dev address often hits spam.
RESEND_FROM="Edmel <hello@yourdomain.com>"

# --- nah.meter accounts (see docs/nahmeter.md) ---
# Supabase project (Settings -> API). The service role key is server-only: never expose it.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Where couriers send Interac e-Transfers (turn on Autodeposit for it at your bank).
NAHMETER_PAY_EMAIL=pay@example.com
# Password for /nahmeter/admin (any user name). At least 16 characters.
NAHMETER_ADMIN_PASSWORD=change-me-to-a-long-random-string
# The site the sign-in link points at (optional; defaults to https://edmel.dev).
NAHMETER_SITE_URL=https://edmel.dev
